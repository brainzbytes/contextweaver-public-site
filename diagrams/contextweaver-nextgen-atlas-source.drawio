        <mxCell id="legend-card-1" value="&lt;b&gt;01&lt;/b&gt;&lt;br&gt;Agents never receive provider credentials or direct provider&lt;br&gt;network routes." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0b1d13;strokeColor=#44df7d;strokeWidth=1.5;fontColor=#effaf1;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;shadow=1;" vertex="1" parent="1">
